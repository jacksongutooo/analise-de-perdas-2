# ─── Banco de dados (PostgreSQL) ────────────────────────────────────────
# Em produção (Neon, Supabase, RDS...) use a URL com pooling em DATABASE_URL
# e a conexão direta em DIRECT_URL (usada pelas migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/analise?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/analise?schema=public"

# ─── Segurança ─────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-string-aleatoria-com-pelo-menos-32-caracteres"
# Protege a rota de limpeza automática (a Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="troque-por-outra-string-aleatoria"

# ─── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Análise de Perdas"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Exibidos no rodapé e na Política de Privacidade. Preencha antes de publicar.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=""
NEXT_PUBLIC_COMPANY_CNPJ=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_DPO_EMAIL=""

# ─── Regras do processo ────────────────────────────────────────────────
# Prazo, em dias úteis a partir do envio (pagamento confirmado), para a equipe entrar em contato com o resultado.
REVIEW_DAYS=15
# Na Vercel cada requisição é limitada a 4,5 MB: mantenha 4 ou menos.
MAX_UPLOAD_MB=4
MAX_FILES_PER_CASE=40
# Rascunhos não enviados (e seus arquivos) são apagados após este prazo.
DRAFT_TTL_DAYS=7
# Ano do ComprovaBet anual pedido no envio (documento principal da análise).
COMPROVABET_YEAR=2025

# ─── Pagamento da análise: PIX pela BlackCat (antes da solicitação) ────
# Valor da análise, cobrado no PIX. Ex.: "197,00". Obrigatório em produção. Definido só no servidor.
# (No modo demonstração, vazio = valor de exemplo R$ 97,00.)
ANALYSIS_PRICE=""
# Chave da API da BlackCat (cabeçalho X-API-Key). SOMENTE no servidor: nunca use o prefixo NEXT_PUBLIC_.
BLACKCAT_API_KEY=""
# URL base da API (vazio = endereço oficial). URL do webhook, enviada em cada cobrança:
# https://SEU-DOMINIO/api/payments/webhook/blackcat (usa NEXT_PUBLIC_SITE_URL, que precisa ser https).
BLACKCAT_BASE_URL="https://api.blackcatoficial.com/api"

# ─── Armazenamento privado dos documentos ──────────────────────────────
# local = pasta privada no servidor (desenvolvimento ou VPS com disco persistente)
# s3    = AWS S3, Cloudflare R2, Backblaze B2, MinIO... (obrigatório na Vercel)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ─── Modo demonstração ─────────────────────────────────────────────────
# true = exibe a faixa DEMO MODE e o sistema passa a trabalhar SOMENTE com dados
# de demonstração (dados reais ficam invisíveis, e vice-versa).
DEMO_MODE="false"
